# ============================================================================
# RetroMarket Production Environment Configuration (.env.example)
# Copy to .env and populate with real production secrets.
# NEVER commit .env or real secret values to source control.
# ============================================================================

# --- Core Server & Database ---
PORT=3000
NODE_ENV=production
APP_URL=https://your-retromarket-domain.example
DATABASE_PATH=./data/retromarket.sqlite
TRUST_PROXY=true

# --- Private Admin Portal (Not Linked on Public Storefront) ---
# Must be 8-80 alphanumeric, hyphen, or underscore characters (e.g., ops-portal-9f4c2a8b)
ADMIN_SECRET_PATH=
ADMIN_SESSION_TTL_MINUTES=120
ADMIN_RESET_TTL_MINUTES=20

# Optional one-time startup provisioning for initial administrator account.
# Prefer running `npm run provision:admin` interactively, or set temporarily on first boot then remove.
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=

# --- Real SMTP Email Delivery (Required for Admin Password Reset & Inquiry Forwarding) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- CyberSource Secure Acceptance Hosted Checkout ---
# CYBERSOURCE_ENV must be "test" (sandbox) or "live" (production)
CYBERSOURCE_ENV=test
CYBERSOURCE_MERCHANT_ID=
CYBERSOURCE_PROFILE_ID=
CYBERSOURCE_ACCESS_KEY=
CYBERSOURCE_SECRET_KEY=

# --- Cryptocurrency Payments (BTC / ETH / USDT) ---
# Configure real merchant wallets via environment variables or inside Admin -> Website Settings.
CRYPTO_BTC_WALLET=
CRYPTO_ETH_WALLET=
CRYPTO_USDT_WALLET=
CRYPTO_USDT_NETWORK=ERC-20

# Live exchange-rate quoting (set to "true" in production)
CRYPTO_ENABLE_LIVE_RATES=true
CRYPTO_RATE_API_URL=https://api.coingecko.com/api/v3/simple/price
CRYPTO_INVOICE_TTL_MINUTES=30

# Minimum on-chain confirmations required before automatic settlement
CRYPTO_BTC_CONFIRMATIONS=2
CRYPTO_ETH_CONFIRMATIONS=12
CRYPTO_USDT_CONFIRMATIONS=12

# Trusted Blockchain Verification / Payment Processor Webhook
# Provide either an on-chain verifier endpoint (BTC Esplora API / ETH JSON-RPC / TronGrid)
# and/or a shared HMAC-SHA256 webhook secret for your crypto payment processor.
BTC_EXPLORER_API_URL=
ETH_RPC_URL=
TRONGRID_API_KEY=
CRYPTO_WEBHOOK_SECRET=
