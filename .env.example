# ============================================================================
# RetroMarket — Supabase Environment Configuration (.env.example)
# Copy to .env and populate with your Supabase project credentials.
# NEVER commit .env or private secrets to source control.
# NEVER expose a Supabase service_role key in frontend code.
# ============================================================================

# --- Core Server ---
PORT=3000
NODE_ENV=production
TRUST_PROXY=true

# --- Private Admin Portal URL Slug (Not Linked on Public Storefront) ---
# Must be 8-80 alphanumeric, hyphen, or underscore characters (e.g., ops-portal-9f4c2a8b)
ADMIN_SECRET_PATH=

# --- Supabase Backend (Database, Storage & Administrator Authentication) ---
# Find these in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Supabase Storage bucket for product images & manual crypto QR codes (public read, admin write via RLS)
SUPABASE_STORAGE_BUCKET=product-images
