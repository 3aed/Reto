# ============================================================================
# RetroMarket — Supabase Environment Configuration (.env.example)
# Copy to .env and populate with your Supabase project credentials.
# NEVER commit .env or private secrets to source control.
# NEVER expose a Supabase service_role key in frontend code.
# ============================================================================

# --- Core Server ---
PORT=3000
NODE_ENV=production
TRUST_PROXY=true

# --- Private Admin Portal URL Slug (Not Linked on Public Storefront) ---
# Must be 8-80 alphanumeric, hyphen, or underscore characters (e.g., ops-portal-9f4c2a8b)
ADMIN_SECRET_PATH=

# --- Supabase Backend (Database, Storage & Administrator Authentication) ---
# Find these in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional (SERVER-SIDE ONLY — NEVER expose to frontend or client code):
# Used exclusively on the backend to automatically provision/confirm the initial
# Supabase Auth administrator account from ADMIN_EMAIL & ADMIN_PASSWORD.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage bucket for product images & manual crypto QR codes (public read, admin write via RLS)
SUPABASE_STORAGE_BUCKET=product-images

# --- Initial Administrator Credentials (SERVER-SIDE ONLY) ---
# Used only to provision/sync the initial Supabase Auth administrator account.
# Never exposed to frontend bundles, public APIs, or stored in plain text in the database.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Telegram Bot Notifications (SERVER-SIDE ONLY — NEVER expose to frontend) ---
# Bot token from @BotFather; Chat ID from @userinfobot or getUpdates (comma-separated for multiple).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
